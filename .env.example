# Copy to .env for local development (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pidaka
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:5000

# Optional. Without these, Google/Apple still work on the local demo wall.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Required in production for /hearth (the keeper's room).
ADMIN_SECRET=replace-with-a-long-random-admin-key

# Phone codes. Production needs one of these. Without them, the phone door stays dark.
# India: MSG91 + a DLT OTP template is the usual path.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio works too. Trial accounts can only text numbers you verify in Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
