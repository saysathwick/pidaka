# Copy to .env for local development (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pidaka
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:5000

# Optional. Without these, Google/Apple still work on the local demo wall.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional. Without Twilio, the phone code is shown in the dialog on this machine.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
